# ~/.config/mako/config

font=Roboto 12
width=420
height=140
margin=7
padding=22
border-size=0
border-radius=25
icons=1
max-icon-size=64

background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#89b4fa

progress-color=over #313244

default-timeout=2000
ignore-timeout=0
max-visible=7
sort=-time

anchor=top-right
layer=overlay

[urgency=low]
border-color=#585b70
default-timeout=4000

[urgency=normal]
border-color=#89b4fa
default-timeout=7000

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
